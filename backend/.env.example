# ============================================================
# On-Demand FnB Staffing Yogyakarta — Environment Variables
# Salin file ini menjadi .env dan isi nilainya
# ============================================================

# Server
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Supabase (https://supabase.com → Settings → API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# JWT Secret (gunakan nilai panjang dan acak)
JWT_SECRET=your_super_secret_jwt_key_min_32_chars

# Firebase Cloud Messaging (FCM)
# Download serviceAccountKey.json dari Firebase Console → Project Settings → Service Accounts
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_key_here\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com

# Xendit Payment Gateway (https://dashboard.xendit.co → Settings → API Keys)
# MOCK MODE aktif jika XENDIT_MOCK=true
XENDIT_SECRET_KEY=xnd_development_your_key_here
XENDIT_MOCK=true

# Google Maps API (untuk geocoding tambahan)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# WhatsApp Business API (opsional untuk MVP)
WA_API_URL=https://api.wa.business/v1
WA_API_TOKEN=your_wa_token

# Platform Config
PLATFORM_SERVICE_FEE_PER_HOUR=3000
MAX_WORKER_SEARCH_RADIUS_KM=5
MIN_WORKER_RATING=4.5
GEOFENCE_CHECKIN_RADIUS_METERS=50
NO_SHOW_GRACE_PERIOD_MINUTES=20
REMINDER_HOURS_BEFORE_SHIFT=2
EARLY_ACCESS_MINUTES_PLATINUM=15
EARLY_ACCESS_MINUTES_GOLD=10
SALARY_ROUNDING_MINUTES=15
